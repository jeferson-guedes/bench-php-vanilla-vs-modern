# Valores padrao (sobrescritos pelas variaveis de ambiente do docker-compose)
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=changeme_benchmark_secret_please_override

# A serverVersion evita uma conexao "de descoberta" ao MySQL durante o boot
# (importante para workers de longa duracao e para o warmup de cache no build).
DATABASE_URL="mysql://bench:bench@mysql:3306/benchmark?serverVersion=8.0.32&charset=utf8mb4"
