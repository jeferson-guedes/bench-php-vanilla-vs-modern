{
    "type": "project",
    "license": "MIT",
    "description": "Mini-monolito Symfony para benchmark de runtimes PHP (FPM/JIT, FrankenPHP Worker, Swoole)",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/orm": "^3.3",
        "runtime/frankenphp-symfony": "^0.2",
        "symfony/console": "7.2.*",
        "symfony/dotenv": "7.2.*",
        "symfony/framework-bundle": "7.2.*",
        "symfony/runtime": "7.2.*",
        "symfony/var-exporter": "7.2.*",
        "symfony/yaml": "7.2.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "comment-policy": "PoC local: config.policy.advisories.block=false desativa o bloqueio do Composer por security advisory (advisories recentes do Symfony cobrem toda a linha 7.x). NAO usar em producao.",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
